# Frontend -> Strapi integration
STRAPI_URL=http://localhost:1337
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Use a read-only Strapi API token when endpoints are protected
STRAPI_API_TOKEN=replace-with-strapi-api-token

# Optional client-side gate for local admin pages
NEXT_PUBLIC_ADMIN_PASSWORD=change-me

# Optional bridge URL for deployed/static environments
NEXT_PUBLIC_CMS_BRIDGE_URL=

# Optional override for scripts/fetch-cms-data.mjs
CMS_SITE_DATA_URL=http://localhost:3000/api/cms/site
