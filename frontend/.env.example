# Frontend -> Strapi integration
STRAPI_URL=http://localhost:1337
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Use a read-only Strapi API token when endpoints are protected
STRAPI_API_TOKEN=replace-with-strapi-api-token

# Optional client-side gate for local admin pages
NEXT_PUBLIC_ADMIN_PASSWORD=change-me

# Optional bridge URL for deployed/static environments
NEXT_PUBLIC_CMS_BRIDGE_URL=

# Optional override for scripts/fetch-cms-data.mjs
CMS_SITE_DATA_URL=http://localhost:3000/api/cms/site

# GitHub Pages base path — defaults to /The_Vlog if unset
# Set this if your repo name differs from The_Vlog
NEXT_PUBLIC_REPO_BASE_PATH=/The_Vlog

# Comma-separated IPs/hostnames for cross-origin dev requests (allowedDevOrigins)
# Set in .env.local, not here — this value is machine-specific
# NEXT_PUBLIC_ALLOWED_DEV_ORIGINS=10.0.3.27

# Strapi production hostname (e.g. your-app.onrender.com) for Next.js image remotePatterns
# Required for images uploaded to Strapi to load in production
NEXT_PUBLIC_STRAPI_HOSTNAME=your-app.onrender.com
